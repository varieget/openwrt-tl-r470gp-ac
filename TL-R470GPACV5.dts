/dts-v1/;

#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "tplink,tl-r470gp-ac-v5", "mediatek,mt7621-soc";
	model = "TL-R470GP-AC";

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x8000000>; /* 128MB DDR3 */
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	leds {
		compatible = "gpio-leds";

		system {
			label = "tl-r470gp-ac-v5:green:system";
			gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		reset {
			label = "reset";
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>; /* 50MHz */

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>; /* 192 KB */
				read-only;
			};

			factory: partition@30000 {
				label = "factory";
				reg = <0x30000 0x10000>; /* 64 KB */
				read-only;
			};

			partition@40000 {
				label = "firmware";
				compatible = "denx,uimage";
				reg = <0x40000 0xfc0000>;
			};
		};
	};
};

&ethernet {
	mtd-mac-address = <&factory 0x0d>;
};

&pinctrl {
	state_default: pinctrl0 {
		gpio {
			ralink,group = "jtag", "uart2", "uart3", "wdt", "pcie", "sdhci";
			ralink,function = "gpio";
		};
	};
};
